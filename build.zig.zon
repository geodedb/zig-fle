.{
    .name = .fle,
    .version = "0.1.7",
    .fingerprint = 0x478bdffc95f027d4,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.6#aa4493781d962f42ba1dd37261e0e107be5f6ffe",
            .hash = "thread_pool-0.2.5-11B1BiNceQDdiX2mLCg-blCuvBT0ZHh0_A_gH9j7t2Gl",
        },
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git#v0.1.15",
            .hash = "otel-0.1.15-B0v3lrz2NQDlzY3t-QLNpP4PE3UylgFDF__MoZZTWNJt",
            .lazy = true,
        },
        // Local PATH dependency for the FIPS backend. There is no published
        // remote yet, so it is wired as an absolute path. `.lazy = true`
        // keeps a default (-Dfips=false) build from ever resolving it: the
        // dep is reached only by `b.lazyDependency("fips", ...)` in build.zig
        // when -Dfips=true. The eventual production form is the git+https
        // lazy entry:
        //   .fips = .{
        //       .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.0#<commit-sha>",
        //       .hash = "<zig-package-hash>",
        //       .lazy = true,
        //   },
        .fips = .{
            .path = "../../../../../devnw/zig/fips",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
