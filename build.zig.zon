.{
    .name = .fle,
    .version = "0.1.13",
    .fingerprint = 0x478bdffc95f027d4,
    .minimum_zig_version = "0.16.0",
    .dependencies = .{
        .thread_pool = .{
            .url = "git+https://gitlab.com/devnw/zig/thread-pool.git?ref=v0.2.7#54a2ddda1a356c32ba2e4df70691459570fb6339",
            .hash = "thread_pool-0.2.7-11B1BvRneQBnMkDnRbKd76THvZn4ZhDhmlWQw-aziWQm",
        },
        .otel = .{
            .url = "git+https://gitlab.com/devnw/zig/otel.git?ref=v0.1.21#7e4261c3db1ba166384d5df5ff95576a2a62f4b0",
            .hash = "otel-0.1.20-B0v3liX3NQBBDic7ltvLZtBWaKCYjca_83Q3WwlLyfL_",
            .lazy = true,
        },
        // Local PATH dependency for the FIPS backend. There is no published
        // remote yet, so it is wired as an absolute path. `.lazy = true`
        // keeps a default (-Dfips=false) build from ever resolving it: the
        // dep is reached only by `b.lazyDependency("fips", ...)` in build.zig
        // when -Dfips=true. The eventual production form is the git+https
        // lazy entry:
        //   .fips = .{
        //       .url = "git+https://gitlab.com/devnw/zig/fips.git?ref=v0.1.0#<commit-sha>",
        //       .hash = "<zig-package-hash>",
        //       .lazy = true,
        //   },
        .fips = .{
            .path = "../../../../../devnw/zig/fips",
            .lazy = true,
        },
    },
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "LICENSE",
        "README.md",
    },
}
